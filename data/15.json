      "image": "data/images/15/page_1.png"
    },
    {
      "page": 2,
      "text": null,
      "image": "data/images/15/page_2.png"
    },
    {
      "page": 3,
      "text": "ПРЕДУВЕДОМЛЕНИЕ\nВ книге представлены тексты на рассто-\nянии Левенштейна 10 друг от друга. Безза-\nстенчиво использованы фрагменты из Гер-\nмана Лукомникова, Ивана Ахметьева, Дмит-\nрия Авалиани, Сергея Федина, Иосифа Брод-\nского, Булата Окуджавы, Юнны Мориц (здо-\nрового человека), Петра Ершова и впс.\n",
      "image": "data/images/15/page_3.png"
    },
    {
      "page": 4,
      "text": "Григорий Померанц\n- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_4.png"
    },
    {
      "page": 5,
      "text": "газетный утенок\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nчерный лебедь\n",
      "image": "data/images/15/page_5.png"
    },
    {
      "page": 6,
      "text": "А. С. Пушкин\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nМ. Ю. Лермонтов\n",
      "image": "data/images/15/page_6.png"
    },
    {
      "page": 7,
      "text": "Андрей Белый\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_7.png"
    },
    {
      "page": 8,
      "text": "подосиновики\n(на срезе синенькие)\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nподберёзовики\n(на срезе розовенькие)\n",
      "image": "data/images/15/page_8.png"
    },
    {
      "page": 9,
      "text": "...Вновь из России\nГуси летят...\nТут не простили,\nТам не простят.\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n...Снова в Россию\nГуси летят...\nТам не простили\nТут не простят.\n",
      "image": "data/images/15/page_9.png"
    },
    {
      "page": 10,
      "text": "Гарин\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nМихайловский\n",
      "image": "data/images/15/page_10.png"
    },
    {
      "page": 11,
      "text": "Румянцев\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nЗадунайский\n",
      "image": "data/images/15/page_11.png"
    },
    {
      "page": 12,
      "text": "Орлов\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nЧесменский\n",
      "image": "data/images/15/page_12.png"
    },
    {
      "page": 13,
      "text": "Семёнов\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nТян-Шанский\n",
      "image": "data/images/15/page_13.png"
    },
    {
      "page": 14,
      "text": "бессмысленный\nи беспощадный\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nбеспомощный\nи бесполезный\n",
      "image": "data/images/15/page_14.png"
    },
    {
      "page": 15,
      "text": "Меч тупо... это...\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nМечту поэта!\n",
      "image": "data/images/15/page_15.png"
    },
    {
      "page": 16,
      "text": "Наконец-то конец.\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nНакати-ка стаканец.\n",
      "image": "data/images/15/page_16.png"
    },
    {
      "page": 17,
      "text": "Нам быт – удавка, нары.\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nНам бы туда, в Канары!\n",
      "image": "data/images/15/page_17.png"
    },
    {
      "page": 18,
      "text": "Закон, число, вожди, дуб, инок.\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nЗакончи слово, жди дубинок.\n",
      "image": "data/images/15/page_18.png"
    },
    {
      "page": 19,
      "text": "всё моё сказала злата понировская\nвсё моё сказал булат окуджава\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nвсё куплю сказала злата понировская\nвсё возьму сказал булат окуджава\n",
      "image": "data/images/15/page_19.png"
    },
    {
      "page": 20,
      "text": "отсутствие\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_20.png"
    },
    {
      "page": 21,
      "text": "минимализм\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_21.png"
    },
    {
      "page": 22,
      "text": "белый стих\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_22.png"
    },
    {
      "page": 23,
      "text": "ЖИВУ * ВИЖУ\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nБУЛАТОВ\n",
      "image": "data/images/15/page_23.png"
    },
    {
      "page": 24,
      "text": "Бродский – гений\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nРейн – Евгений\n",
      "image": "data/images/15/page_24.png"
    },
    {
      "page": 25,
      "text": "Алешковский – Юз\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nСоветский – Союз\n",
      "image": "data/images/15/page_25.png"
    },
    {
      "page": 26,
      "text": "пуантилизм\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n...\n",
      "image": "data/images/15/page_26.png"
    },
    {
      "page": 27,
      "text": "то ли «любить»\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nто ли просто «эй»\n",
      "image": "data/images/15/page_27.png"
    },
    {
      "page": 28,
      "text": "то ли подъём упадка\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nто ли упадок подъёма\n",
      "image": "data/images/15/page_28.png"
    },
    {
      "page": 29,
      "text": "То ли розою востока\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nТо ли гурией пророка\n",
      "image": "data/images/15/page_29.png"
    },
    {
      "page": 30,
      "text": "то ли поздняя невеста\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nто ли юная вдова\n",
      "image": "data/images/15/page_30.png"
    },
    {
      "page": 31,
      "text": "жалость\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nсострадание\n",
      "image": "data/images/15/page_31.png"
    },
    {
      "page": 32,
      "text": "иудаизм\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nхристианство\n",
      "image": "data/images/15/page_32.png"
    },
    {
      "page": 33,
      "text": "нация\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nнациональность\n",
      "image": "data/images/15/page_33.png"
    },
    {
      "page": 34,
      "text": "цитофлафин\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nмексидол\n",
      "image": "data/images/15/page_34.png"
    },
    {
      "page": 35,
      "text": "фундук\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nлесной орех\n",
      "image": "data/images/15/page_35.png"
    },
    {
      "page": 36,
      "text": "музыка Андрея Волконского\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nслова Анри Волохонского\n",
      "image": "data/images/15/page_36.png"
    },
    {
      "page": 37,
      "text": "девятнадцать\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nдвадцать девять\n",
      "image": "data/images/15/page_37.png"
    },
    {
      "page": 38,
      "text": "минус семь\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_38.png"
    },
    {
      "page": 39,
      "text": "минус десять\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_39.png"
    },
    {
      "page": 40,
      "text": "пятнадцать\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nсто пятнадцать\n",
      "image": "data/images/15/page_40.png"
    },
    {
      "page": 41,
      "text": "Екатеринбург\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nСвердловск\n",
      "image": "data/images/15/page_41.png"
    },
    {
      "page": 42,
      "text": "Калининград\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_42.png"
    },
    {
      "page": 43,
      "text": "Соловьев – Седой\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nНовиков – Прибой\n",
      "image": "data/images/15/page_43.png"
    },
    {
      "page": 44,
      "text": "Козловский\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nЛемешев\n",
      "image": "data/images/15/page_44.png"
    },
    {
      "page": 45,
      "text": "Чарли Чаплин\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_45.png"
    },
    {
      "page": 46,
      "text": "при социализме коммуналка\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nпри коммунизме социалка\n",
      "image": "data/images/15/page_46.png"
    },
    {
      "page": 47,
      "text": "крем-брюле\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nмороженое крем-брюле\n",
      "image": "data/images/15/page_47.png"
    },
    {
      "page": 48,
      "text": "гомеопатия\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_48.png"
    },
    {
      "page": 49,
      "text": "медведица с мёдом\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nгололедица с гололёдом\n",
      "image": "data/images/15/page_49.png"
    },
    {
      "page": 50,
      "text": "птица додо\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_50.png"
    },
    {
      "page": 51,
      "text": "Геркуланум\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_51.png"
    },
    {
      "page": 52,
      "text": "град Китеж\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\n",
      "image": "data/images/15/page_52.png"
    },
    {
      "page": 53,
      "text": "Manchester\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nLiverpool\n",
      "image": "data/images/15/page_53.png"
    },
    {
      "page": 54,
      "text": "короче\n- - - - - - - - - - - - - - - - - - - - - - - - - - - -\nспокойной ночи\n",
      "image": "data/images/15/page_54.png"
    },
